@unpublished{afshar_luxury_saving,
  title    = {Progressive Taxation and Dynamic Wealth Inequality under Luxury Saving},
  author   = {Afshar, Arashk},
  year     = {2026},
  group    = {Job Market Paper},
  note     = {Job Market Paper},
  selected = {true},
  abstract = {Wealth inequality has risen across the developed world for four decades, through repeated rounds of progressive taxation. This paper offers one reason why. When saving is a luxury good, so that the rich set aside a rising share of their wealth, the distribution pulls apart on its own — and a tax can compress it at every date while the sequence of distributions still pulls apart. Reducing inequality at a moment and reducing it over time turn out to be different problems, and the criterion economists use was built for the first. Commodity and income taxes cannot touch the second. A wealth tax can, but only through a feature of the schedule the policy debate has ignored: how steeply post-tax wealth rises with pre-tax wealth. Every wealth tax enacted or proposed leaves that essentially flat at the top, whatever its headline rate. The instruments were designed for a snapshot; the problem is a trajectory.}
}

@unpublished{afshar_informed_voter,
  title    = {The Myth of the Informed Voter},
  author   = {Afshar, Arashk},
  year     = {2026},
  group    = {Working Papers},
  abstract = {This paper develops a model of political campaigns in which spending shapes elections not by informing voters but by directing their attention to the issues candidates choose. Campaigns cannot change what voters believe, only what they weigh; even a fully informed electorate can be decided by which issues are made salient. Each candidate concentrates on the issue she owns, and the owner of the loudest issue wins, however narrow her support elsewhere. A binding spending cap prevents any single issue from dominating and forces competition across many issues at once, and with it, potentially, the fate of narrow candidates. Money decides elections not by informing voters, but by setting what the election is about.}
}

@unpublished{afshar_saving_status,
  title    = {Saving as Instrument and Status: Progressive Taxation in a Dynamic Economy},
  author   = {Afshar, Arashk},
  year     = {2026},
  group    = {Working Papers},
  abstract = {My job market paper shows that when saving is a luxury good, no progressive tax guarantees that wealth inequality falls over time. That paper's agents are myopic, choosing period by period, and the natural objection is that the failure is an artifact of the assumption. This paper removes it. With agents who anticipate the returns to accumulation and plan accordingly, the divergence is stronger, not weaker: the wealthy save more aggressively when they foresee what saving earns them. Containing it then requires marginal-rate progressivity, a stricter standard than the average-rate progressivity that suffices at a single date, and one no wealth tax in force approaches.}
}
