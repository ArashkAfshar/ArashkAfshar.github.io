@unpublished{afshar_luxury_saving,
  title    = {Saving as a Luxury Good: Why Progressive Taxation Cannot Guarantee Falling Inequality},
  author   = {Afshar, Arashk},
  year     = {2026},
  group    = {Job Market Paper},
  note     = {Job Market Paper},
  selected = {true},
  abstract = {Wealth inequality has risen for half a century across every developed economy, through decades of progressive taxation. This paper offers one reason why. When saving is a luxury good, so that the rich set aside a systematically larger share of their wealth, the distribution pulls apart on its own, and no progressive schedule can be counted on to stop it. Commodity and income taxes leave the divergence untouched. A wealth tax reaches it, but only through a feature of the schedule that the policy debate has ignored: how steeply post-tax wealth rises with pre-tax wealth. Every wealth tax enacted or proposed leaves that essentially flat at the top, whatever its headline rate.}
}

