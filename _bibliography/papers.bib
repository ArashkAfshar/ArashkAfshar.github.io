@unpublished{afshar_luxury_saving,
  title    = {Saving as a Luxury Good: Why Progressive Taxation Cannot Guarantee Falling Inequality},
  author   = {Afshar, Arashk},
  year     = {2026},
  note     = {Job Market Paper},
  abstract = {When saving is a luxury good---the rich save a systematically larger share of wealth---the distribution pulls apart on its own, and redistributive taxation faces a limit that static analysis cannot see. Any progressive tax compresses the distribution within a period, but no instrument inherits this universality across periods: commodity taxes can reverse their own equalization, and income taxes fail for every luxury preference. The wealth tax alone reaches accumulated wealth at its source, yet it too carries no guarantee: what governs the trajectory is not the tax rate but the elasticity of retention, which every enacted or proposed wealth tax leaves essentially undisturbed at the top.}
}

