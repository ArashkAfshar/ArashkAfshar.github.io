@unpublished{afshar_luxury_saving,
  title    = {Saving as a Luxury Good: Why Progressive Taxation Cannot Guarantee Falling Inequality},
  author   = {Afshar, Arashk},
  year     = {2026},
  group    = {Job Market Paper},
  selected = {true},
  abstract = {Wealth inequality has risen for half a century across every developed economy, through decades of progressive taxation. This paper offers one reason why. When saving is a luxury good, so that the rich set aside a systematically larger share of their wealth, the distribution pulls apart on its own, and no progressive schedule can be counted on to stop it. Commodity and income taxes leave the divergence untouched. A wealth tax reaches it, but only through a feature of the schedule that the policy debate has ignored: how steeply post-tax wealth rises with pre-tax wealth. Every wealth tax enacted or proposed leaves that essentially flat at the top, whatever its headline rate.}
}

@unpublished{afshar_informed_voter,
  title    = {The Myth of the Informed Voter},
  author   = {Afshar, Arashk},
  year     = {2026},
  group    = {Working Papers},
  abstract = {This paper develops a model of political campaigns in which spending shapes elections not by informing voters but by directing their attention to issues the candidates choose. Even fully informed voters are decided by which issues are made salient. And the candidates who benefit are those selected by elites. Spending raises the salience of chosen issues, and salient issues weigh more heavily when voters compare candidates. When spending is unbounded, the most salient issue becomes decisive, so its owner wins however narrow her support elsewhere. A binding spending cap prevents any single issue from dominating and forces competition across many issues at once, and with it, potentially, the fate of narrow candidates. Money decides elections not by informing voters, but by setting what the election is about.}
}

@unpublished{afshar_saving_status,
  title    = {Saving as Instrument and Status: Progressive Taxation in a Dynamic Economy},
  author   = {Afshar, Arashk},
  year     = {2026},
  group    = {Working Papers},
  abstract = {My job market paper shows that when saving is a luxury good, no progressive tax guarantees that wealth inequality falls over time. That paper's agents are myopic, choosing period by period, and the natural objection is that the failure is an artifact of the assumption. This paper removes it. With agents who anticipate the returns to accumulation and plan accordingly, the divergence is stronger, not weaker: the wealthy save more aggressively when they foresee what saving earns them. Containing it then requires marginal-rate progressivity, a stricter standard than the average-rate progressivity that suffices at a single date, and one no wealth tax in force approaches.}
}
