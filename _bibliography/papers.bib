@unpublished{afshar_luxury_saving,
  title    = {Saving as a Luxury Good: Why Progressive Taxation Cannot Guarantee Falling Inequality},
  author   = {Afshar, Arashk},
  year     = {2026},
  note     = {Job Market Paper},
  group    = {Job Market Paper},
  selected = {true},
  abstract = {When the rich save a systematically larger share of their wealth, the distribution pulls apart on its own, and no conventional tax instrument inherits the classical guarantee that progressivity compresses it: commodity taxes can reverse their own equalization, and income taxes fail for every luxury preference. The wealth tax alone reaches accumulated wealth at its source, yet it too carries no guarantee---what governs the long-run trajectory is not the tax rate but the elasticity of retention, how post-tax wealth scales with pre-tax wealth at the top. Because every enacted or proposed wealth tax is asymptotically proportional there, it leaves this elasticity essentially undisturbed, and the debate has been conducted over the wrong parameter.}
}

@unpublished{afshar_informed_voter,
  title    = {The Myth of the Informed Voter},
  author   = {Afshar, Arashk},
  year     = {2026},
  group    = {Working Papers},
  abstract = {This paper develops a model of political campaigns in which advertising manipulates voters not by informing them but by directing their attention to issues chosen by candidates, who are selected by elites. Under unlimited campaign funding, the equilibrium concentrates voter attention on a narrow set of issues and favors more extreme candidates. Restricting funding reverses this: the equilibrium shifts toward a more moderate candidate and a better-informed electorate, offering an equilibrium rationale for campaign-finance limits without abandoning voter rationality.}
}

@unpublished{afshar_saving_status,
  title    = {Saving as Instrument and Status: Progressive Taxation in a Dynamic Economy},
  author   = {Afshar, Arashk},
  year     = {2026},
  group    = {Working Papers},
  abstract = {{In a static economy, progressive taxation cannot guarantee that wealth inequality falls over time once saving is a luxury good. This paper asks whether that conclusion survives in a dynamic, life-cycle economy, where saving carries additional force as both an instrument for future consumption and a marker of status. Because forward-looking agents anticipate these returns, the wealthy accumulate still more aggressively, and the divergence in wealth sharpens. Preliminary results suggest that containing it requires marginal-rate progressivity, a stricter standard than the average-rate progressivity that suffices in the static case.}
}
